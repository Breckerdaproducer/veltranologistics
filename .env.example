PORT=5200
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=veltrano_logistics
DB_USER=postgres
DB_PASSWORD=your_password

# Authentication
JWT_SECRET=your_jwt_secret_key
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=your_admin_password
ADMIN_EMAIL=info@veltranologistics.site

# Email / SMTP Settings
SMTP_HOST=smtp.hostinger.site
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@veltranologistics.site
SMTP_PASS="your_smtp_password"
SMTP_FROM="Veltrano Logistics Support" <info@veltranologistics.site>
ADMIN_NOTIFY_EMAIL=admin@example.site

# Allowed CORS origins
CORS_ORIGIN=*
